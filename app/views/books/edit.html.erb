<h3>編集</h3>
<hr>
<% if @book.errors.present? %>
<h3>エラーがあります。</h3>
<ul>
  <% @book.errors.full_messages.each do |msg| %>
    <li><%= msg %></li>
  <% end %>
</ul>
<hr>
<% end %>

<%= form_with model: @book do |f| %>
  <p>
  <%= f.label :title, 'タイトル' %>
  <%= f.text_field :title %>
  </p>
  <p>
  <%= f.label :author, '著者' %>
  <%= f.text_field :author %>
  </p>
  <p>
  <%= f.label :published_year, '発刊年' %>
  <%= f.text_field :published_year %>
  </p>
  <%= f.submit '更新' %>
<% end %>