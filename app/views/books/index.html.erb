<div id="content">
<hr class="hr1">

<% if flash[:notice] %>
    <%= flash[:notice] %>
    <hr class="hr1">
<% end %>

<% @books.each do |book| %>
  <p>タイトル：<%= book.title %></p>
  <p>著者：<%= book.author %></p>
  <%= link_to '削除', "/books/#{book.id}", data: {turbo_method: :delete} %>
  <%= link_to '表示', "/books/#{book.id}" %>
  <%= link_to '編集', "/books/#{book.id}/edit" %>
  <hr class="hr1">
<% end %>
<p><%= link_to '新規追加', new_book_path, class:"btn btn-secondary text-dark" %></p>
</div>